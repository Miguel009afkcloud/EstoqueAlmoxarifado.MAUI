
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstoqueAlmoxarifado.Maui.Views.ItensPage"
             Title="Estoque do Almoxarifado">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra de busca -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="10">
            <SearchBar Grid.Column="0"
                       Placeholder="Buscar item..."
                       Text="{Binding TermoBusca}"
                       SearchCommand="{Binding BuscarCommand}" />

            <Button Grid.Column="1"
                    Text="+"
                    Command="{Binding CarregarItensCommand}"
                    WidthRequest="50" />
        </Grid>

        <!-- Lista de itens -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CarregarItensCommand}">

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>

                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Excluir"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItensViewModel}}, Path=ExcluirItemCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Grid Padding="15,10" ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Nome}"
                                           FontSize="16"
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding CategoriaNome}"
                                           FontSize="12"
                                           TextColor="Gray" />

                                    <Label Text="{Binding CodigoBarras, StringFormat='Cód: {0}'}"
                                           FontSize="11"
                                           TextColor="Gray" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center">

                                    <Label Text="{Binding QuantidadeEstoque, StringFormat='Qtd: {0}'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding CorEstoque}"
                                           HorizontalOptions="End" />

                                    <Label Text="{Binding PrecoUnitario, StringFormat='R$ {0:F2}'}"
                                           FontSize="12"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>

                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Nenhum item encontrado."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="16"
                           TextColor="Gray" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>

        <!-- Indicador de carregamento -->

        <ActivityIndicator Grid.Row="1"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>
        </Grid>
    </ContentPage>